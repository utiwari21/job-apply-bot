# Gmail IMAP (read) + optional SMTP (send notifications only).
# SMTP cannot read your inbox. Create a Google App Password:
# Google Account → Security → 2-Step Verification → App passwords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: email yourself a skip/apply log after each listing
NOTIFY_VIA_SMTP=false

# OpenAI API is NOT free (ChatGPT Plus does not include API credits).
# Leave OPENAI_API_KEY empty to skip the model and keep the .base.tex structure.
# If set, the model must return a full compilable .tex file only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
